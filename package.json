{
  "name": "fandom-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "db:up": "docker compose up -d --wait --wait-timeout 60 && bun scripts/init-mongo.ts",
    "db:stop": "docker compose stop",
    "db:clean": "bun scripts/drop-test-databases.ts",
    "test": "bun test --timeout 15000",
    "build": "bun build src/web/client.ts --target browser --minify --outfile dist/app.js",
    "start": "NODE_ENV=production bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "preview": "bun run db:up && bun run build && bun run start"
  },
  "dependencies": {
    "@mit-sdg/sync-engine": "1.2.0",
    "@mit-sdg/sync-engine-http": "1.2.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "typescript": ">=6 <7"
  }
}
